# =============================================================================
# Anthony Muhati Portfolio — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# NEVER commit .env.local to Git.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Your Name

# --- WhatsApp ---------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi Anthony, I found your portfolio and I'd like to discuss a project.

# --- Social Links -----------------------------------------------------------
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-profile
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-profile

# --- SEO --------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_OG_IMAGE=/assets/hero-mockup.webp

# --- Resend (Email) ---------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=your@email.com
RESEND_API_KEY=re_your_resend_api_key
# Email that receives contact form submissions (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
CONTACT_RECEIVER_EMAIL=your@email.com
# Verified sender in Resend (must match a verified domain in your Resend account)
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Portfolio Contact

# =============================================================================
# NOTES:
# - NEXT_PUBLIC_ variables are exposed to the browser.
# - Variables WITHOUT NEXT_PUBLIC_ are server-side only.
# - Set RESEND_API_KEY for the contact form to actually send emails.
# - Without it, form submissions will be logged to console only.
# =============================================================================
